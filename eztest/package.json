{
  "name": "eztest",
  "version": "0.1.0",
  "description": "EZTest - one-stop, verified test automation: web, API, DB, documents, identity, data, performance, accessibility, visual, security and release readiness in a single package.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node tools/testkit/cli.mjs",
    "test:firefox": "node tools/testkit/cli.mjs --browser firefox",
    "test:ci": "node tools/testkit/cli.mjs --reporter default --reporter junit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p examples/enterprise-reference/tsconfig.json --noEmit",
    "eztest": "tsx src/cli/bin.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/build-studio.mjs && node scripts/build-injected.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "tsx examples/demo-app/server.ts",
    "notices": "node scripts/third-party-notices.mjs",
    "build:load-agent": "node scripts/build-load-agent.mjs"
  },
