{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Larkspur claim (GET /v1/claims/{id})",
  "type": "object",
  "required": ["claimId", "policyId", "customerId", "type", "channel", "incidentDate", "reportedAt", "amountClaimed", "status", "priority", "lateNotification", "documents"],
  "properties": {
    "claimId": { "type": "string", "pattern": "^CLM-\\d{6}$" },
    "policyId": { "type": "string", "pattern": "^POL-[HM]-\\d{6}$" },
    "customerId": { "type": "string", "pattern": "^C-\\d{4}$" },
    "type": { "enum": ["WATER", "FIRE", "THEFT", "STORM", "GLASS", "COLLISION"] },
    "channel": { "enum": ["PORTAL", "BROKER", "PHONE"] },
    "incidentDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reportedAt": { "type": "string" },
    "amountClaimed": { "type": "number", "exclusiveMinimum": 0 },
    "status": { "enum": ["SUBMITTED", "IN_REVIEW", "REFERRED", "APPROVED", "REJECTED", "SETTLEMENT_ACCEPTED", "SETTLED"] },
    "priority": { "enum": ["NORMAL", "HIGH"] },
    "lateNotification": { "type": "boolean" },
    "approvedAmount": { "type": ["number", "null"] },
    "payoutAmount": { "type": ["number", "null"] },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "size", "sha256"],
        "properties": { "filename": { "type": "string" }, "size": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    }
  }
}
