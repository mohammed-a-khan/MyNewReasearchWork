{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Larkspur claim event (topic larkspur.claims.events), contract v1",
  "type": "object",
  "required": ["eventId", "type", "occurredAt", "claimId", "policyId", "customerId", "status"],
  "properties": {
    "eventId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "type": { "enum": ["claim.submitted", "claim.in_review", "claim.referred", "claim.approved", "claim.rejected", "settlement.accepted", "claim.paid"] },
    "occurredAt": { "type": "string" },
    "claimId": { "type": "string", "pattern": "^CLM-\\d{6}$" },
    "policyId": { "type": "string" },
    "customerId": { "type": "string" },
    "status": { "type": "string" },
    "approvedAmount": { "type": "number" },
    "payoutAmount": { "type": "number" },
    "deductible": { "type": "number" },
    "currency": { "const": "GBP" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "claim.approved" } } },
      "then": { "required": ["approvedAmount", "payoutAmount", "deductible", "currency", "decisionBy"] }
    }
  ]
}
