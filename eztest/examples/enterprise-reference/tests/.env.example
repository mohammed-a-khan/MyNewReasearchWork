# Secrets for the dev environment (the local reference system). Copy to .env; .env is git-ignored.
# These are test-only values for invented users of a local system. In sit/uat the pipeline
# provides LARKSPUR_* from a variable group / Key Vault instead.
LARKSPUR_AMELIA_PASSWORD=Harbour#2026
LARKSPUR_AMELIA_TOTP=LARKSPURAMELIAMFAQXYZABC
LARKSPUR_ROHAN_PASSWORD=Monsoon#2026
LARKSPUR_ROHAN_TOTP=LARKSPURROHANMFAQXYZABCD
LARKSPUR_BRAMBLE_PASSWORD=Thicket#2026
LARKSPUR_BRAMBLE_TOTP=LARKSPURBRAMBLEMFAQXYZAB
LARKSPUR_ADJUSTER_PASSWORD=ClaimDesk#1
LARKSPUR_BROKER_CLIENT_SECRET=bg-s3cr3t-2026
LARKSPUR_REPORTING_CLIENT_SECRET=ro-s3cr3t-2026
# The partner API for load scenarios (load/*.load.yaml baseUrl); sit/uat get it from the variable group.
LARKSPUR_API_URL=http://127.0.0.1:4702
# Decrypts the ENC(...) values in eztest.config.yaml (the senior adjuster's passphrase).
EZTEST_MASTER_KEY=larkspur-reference-demo-key
