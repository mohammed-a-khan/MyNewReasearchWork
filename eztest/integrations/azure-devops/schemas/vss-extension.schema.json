{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eztest.local/schemas/vss-extension.schema.json",
  "title": "Azure DevOps extension manifest (the subset EZTest uses, from the documented manifest reference)",
  "type": "object",
  "required": ["manifestVersion", "id", "version", "name", "publisher", "targets", "contributions", "files"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "publisher": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
    "description": { "type": "string", "maxLength": 200 },
    "public": { "type": "boolean" },
    "categories": { "type": "array", "items": { "enum": ["Azure Repos", "Azure Boards", "Azure Pipelines", "Azure Test Plans", "Azure Artifacts"] }, "minItems": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "targets": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "version": { "type": "string" } } } },
    "scopes": { "type": "array", "items": { "type": "string", "pattern": "^vso\\.[a-z_.]+$" } },
    "demands": { "type": "array", "items": { "type": "string" } },
    "icons": { "type": "object", "properties": { "default": { "type": "string" } }, "additionalProperties": false },
    "content": { "type": "object", "properties": { "details": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" } } } } },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" }, "addressable": { "type": "boolean" }, "packagePath": { "type": "string" } }, "additionalProperties": false }
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "targets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "targets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "properties": { "type": "object" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "ms.vss-distributed-task.task" } } },
            "then": { "properties": { "properties": { "type": "object", "required": ["name"] } } }
          },
          {
            "if": { "properties": { "type": { "const": "ms.vss-build-web.build-results-tab" } } },
            "then": { "properties": { "targets": { "contains": { "const": "ms.vss-build-web.build-results-view" } }, "properties": { "type": "object", "required": ["name", "uri"] } } }
          }
        ]
      }
    }
  }
}
