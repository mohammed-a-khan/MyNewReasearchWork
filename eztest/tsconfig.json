{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@mohammed-a-khan/eztest": ["./src/index.ts"],
      "@mohammed-a-khan/eztest/components": ["./src/runner/components/index.ts"],
      "@mohammed-a-khan/eztest/*": ["./src/*/index.ts"],
      "eztest/sdk": ["./src/sdk/index.ts"],
      "eztest/bdd": ["./src/bdd/index.ts"],
      "eztest/browser": ["./src/browser/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "examples/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "src/studio/client/**",
    "test/importers/fixtures/**",
    "test/lint/fixtures/**",
    "examples/enterprise-reference/**"
  ]
}
