# Copy to deploy/.env and change every value.
POSTGRES_PASSWORD=change-me
EZTEST_SERVER_BOOTSTRAP_TOKEN=change-me-to-a-long-random-string
# A tester token for the runner (create it with: eztest server token create --name ci --grant default:tester).
EZTEST_SERVER_TOKEN=
# External URL when the server sits behind a TLS proxy, e.g. https://eztest.example.com
EZTEST_SERVER_PUBLIC_URL=
# The project the runner tests (mounted at /work).
EZTEST_PROJECT_DIR=..
EZTEST_IMAGE=eztest:latest
